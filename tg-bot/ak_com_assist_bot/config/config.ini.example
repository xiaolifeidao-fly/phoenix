# 定义分组，复制为 config/config.ini 后按本地环境修改，config.ini 不入仓库
[TELEGRAM]
# bot token 优先取环境变量 TELEGRAM_BOT_TOKEN，此处留空即可
# 仅本地调试时可临时填写，切勿提交明文 token
bot_token =

# 实时上号数量取数配置，留空即用代码里的默认值
[ONLINE_COUNT]
# suffer 公开接口前缀；线上 80 未反代 suffer 时改为 http://116.62.212.29:7091/suffer-web/api
base_url = http://116.62.212.29/suffer-web/api
# 统计窗口，单位秒
window_seconds = 120
# 对外展示时叠加在接口数值上的偏移量
offset = 500
# 请求超时时间，单位秒
timeout_seconds = 5

# 云监控告警转发（alert_main.py），留空即用代码里的默认值
# 敏感配置只放 .env：ALERT_BOT_TOKEN（告警机器人 token）、ALERT_CHAT_ID（告警群 id）、ALERT_PATH_SECRET（回调路径密钥）
# 云监控回调地址：http://<本机公网 IP>/cms-alert/<ALERT_PATH_SECRET>，由同机 nginx 反代到下面的监听端口
[ALERT]
# 监听地址，默认只监听本机
listen_host = 127.0.0.1
listen_port = 18090
# 发 Telegram 的超时时间，单位秒，要小于云监控回调的 5 秒超时
timeout_seconds = 4
